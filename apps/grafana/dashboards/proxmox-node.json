      "targets": [
        {
          "refId": "A",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"uptime\") AS \"uptime\" FROM \"system\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter"
        }
