  "version": 2,
  "panels": [
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": "InfluxDB-Proxmox",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"cpu\") AS \"CPU\" FROM \"cpustat\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter GROUP BY time($__interval) fill(none)"
        },
        {
          "refId": "B",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"wait\") AS \"IO wait\" FROM \"cpustat\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
    {
      "title": "Load Average",
      "type": "timeseries",
      "datasource": "InfluxDB-Proxmox",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"avg1\") AS \"1m\", mean(\"avg5\") AS \"5m\", mean(\"avg15\") AS \"15m\" FROM \"cpustat\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
    {
      "title": "Memory",
      "type": "timeseries",
      "datasource": "InfluxDB-Proxmox",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total" },
            "properties": [ { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"memused\") AS \"used\", mean(\"memtotal\") AS \"total\", mean(\"memfree\") AS \"free\" FROM \"memory\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
    {
      "title": "Swap / ARC",
      "type": "timeseries",
      "datasource": "InfluxDB-Proxmox",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"swapused\") AS \"swap used\", mean(\"swaptotal\") AS \"swap total\", mean(\"arcsize\") AS \"ZFS ARC\" FROM \"memory\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
    {
      "title": "Network Traffic (nics)",
      "type": "timeseries",
      "datasource": "InfluxDB-Proxmox",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT non_negative_derivative(mean(\"receive\"), 1s) AS \"rx\" FROM \"nics\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND (\"instance\" =~ /^(en|eth|vmbr)/) AND $timeFilter GROUP BY time($__interval), \"instance\" fill(none)"
        },
        {
          "refId": "B",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT non_negative_derivative(mean(\"transmit\"), 1s) AS \"tx\" FROM \"nics\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND (\"instance\" =~ /^(en|eth|vmbr)/) AND $timeFilter GROUP BY time($__interval), \"instance\" fill(none)"
        }
      ]
    },
    {
      "title": "Disk I/O (blockstat)",
      "type": "timeseries",
      "datasource": "InfluxDB-Proxmox",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
