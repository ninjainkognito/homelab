        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT non_negative_derivative(mean(\"rd_bytes\"), 1s) AS \"read\" FROM \"blockstat\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter GROUP BY time($__interval), \"instance\" fill(none)"
        },
        {
          "refId": "B",
          "datasource": "InfluxDB-Proxmox",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT non_negative_derivative(mean(\"wr_bytes\"), 1s) AS \"write\" FROM \"blockstat\" WHERE \"object\" = 'nodes' AND \"host\" =~ /^$node$/ AND $timeFilter GROUP BY time($__interval), \"instance\" fill(none)"
        }
      ]
    },
